# 网站验证代码（用于搜索引擎站长工具验证）
# 复制此文件为 .env 并填入实际值

# 百度搜索资源平台
# 获取方式: https://ziyuan.baidu.com → 用户中心 → 站点管理 → 验证站点 → HTML标签验证
PUBLIC_BAIDU_SITE_VERIFICATION=codeva-Xg16rNOdRw

# Google Search Console 和 Bing Webmaster 已通过其他方式验证
# 如需使用 HTML 验证方式，可取消下面注释：
# PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here
# PUBLIC_BING_SITE_VERIFICATION=your_bing_verification_code_here

# 其他可选的SEO相关配置
PUBLIC_SITE_URL=https://architext.cn

# Umami 分析配置
# 获取方式: 在你的 Umami 后台添加网站后获取跟踪代码
UMAMI_SCRIPT_URL=https://analytics.yourdomain.com/script.js
UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
