          <!-- Path A: New Project -->
          <div class="path-card">
            <div class="path-header">
              <span class="path-tag">路径 A</span>
              <h3>新项目</h3>
            </div>
            <div class="path-flow">
              <div class="flow-step">
                <span style="font-family:var(--font-mono);font-size:0.8rem;color:var(--accent-gold)">填写 brief</span>
