              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step">
                <code>/archi.start</code>
                <span>从 brief 建立项目宪法</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step optional">
                <code>/archi.ui</code>
                <span>生成 UI 概念设计（仅UI项目）</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step">
                <code>/archi.plan</code>
                <span>架构访谈</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step">
                <code>/archi.code</code>
                <span>按阶段逐步实现</span>
              </div>
            </div>
          </div>

          <!-- Path B: Existing Code -->
          <div class="path-card">
            <div class="path-header">
              <span class="path-tag">路径 B</span>
              <h3>已有代码库</h3>
            </div>
            <div class="path-flow">
              <div class="flow-step">
                <code>/archi.inherit</code>
                <span>逆向分析代码</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step optional">
                <code>/archi.ui</code>
                <span>生成 UI 概念设计（仅UI项目）</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step">
                <code>/archi.scope</code>
                <span>新需求</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step">
                <code>/archi.plan</code>
                <span>规划功能</span>
              </div>
              <div class="flow-arrow">↓</div>
              <div class="flow-step">
                <code>/archi.code</code>
                <span>实现</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 其他常见指令 -->
      <div class="day2-ops">
        <p class="ops-label">其他常见指令</p>
