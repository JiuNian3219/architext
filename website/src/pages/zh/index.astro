  <section class="quickstart" id="quickstart">
    <div class="container">
      <span class="eyebrow">快速开始</span>
      <h2 class="section-title">终端入口。<br><em>然后 AI 接管。</em></h2>

      <!-- Terminal Gate -->
      <div class="terminal-gate">
        <p class="gate-desc">从这里开始。一条命令部署框架。</p>
        <div class="terminal-window">
          <div class="terminal-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="terminal-body">
            <span class="prompt">$</span> <span class="command">npx archi init</span>
            <div class="terminal-output">
              <p>? 选择语言 › 简体中文</p>
              <p>? 选择 IDE › Cursor</p>
              <p>? 项目特征 › UI, Data, API</p>
              <p>? 生成 project-brief.md? › 是</p>
