<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Architext — AI 架构协议</title>
  <meta name="description" content="面向中小型应用的文档驱动 AI 开发协议。为 1 人 + AI 助手协作设计。先定义，再构建。">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    fetch('https://registry.npmjs.org/architext/latest')
      .then(r => r.json())
      .then(d => {
        document.getElementById('version').textContent = 'v' + d.version;
      })
      .catch(() => {});

    // 绘制工作流 Canvas
    (function() {
      const canvas = document.getElementById('workflow-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      canvas.width = 900 * dpr;
      canvas.height = 280 * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = '900px';
      canvas.style.height = '280px';

      const centerY = 160;
      const nodes = [
        { x: 150, cmd: '/archi.start', desc: '建立项目宪法', top: true },
        { x: 300, cmd: '/archi.ui', desc: '生成 UI 概念', top: false },
        { x: 450, cmd: '/archi.plan', desc: '架构访谈', top: true },
        { x: 600, cmd: '/archi.code', desc: '逐步实现', top: false },
        { x: 750, cmd: '/archi.audit', desc: '深度审查', top: true }
      ];

      const gold = '#b88a3f';
      const goldDim = 'rgba(184, 138, 63, 0.3)';
      const textDim = '#9a9088';
      const bg = '#161210';

      ctx.beginPath();
      ctx.moveTo(80, centerY);
      ctx.lineTo(820, centerY);
      ctx.strokeStyle = goldDim;
      ctx.lineWidth = 2;
      ctx.stroke();

      nodes.forEach((node, i) => {
        const yOffset = node.top ? -80 : 80;
        const targetY = centerY + yOffset;

        ctx.beginPath();
        ctx.moveTo(node.x, centerY);
        ctx.lineTo(node.x, targetY);
        ctx.strokeStyle = goldDim;
        ctx.lineWidth = 1;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(node.x, targetY, 4, 0, Math.PI * 2);
        ctx.fillStyle = gold;
        ctx.fill();

        const boxW = 110, boxH = 36;
        const boxX = node.x - boxW / 2;
        const boxY = targetY - boxH / 2 - 8;
        ctx.fillStyle = bg;
        ctx.strokeStyle = gold;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.roundRect(boxX, boxY, boxW, boxH, 4);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = gold;
        ctx.font = '11px "IBM Plex Mono", monospace';
        ctx.textAlign = 'center';
        ctx.fillText(node.cmd, node.x, boxY + 22);

        ctx.fillStyle = textDim;
        ctx.font = '9px "IBM Plex Mono", monospace';
        ctx.fillText(node.desc, node.x, boxY + boxH + 12);
      });

      nodes.forEach(node => {
        ctx.beginPath();
        ctx.arc(node.x, centerY, 5, 0, Math.PI * 2);
        ctx.fillStyle = gold;
        ctx.fill();
      });
    })();
  </script>
  <style>
    :root {
      /* Amber Blueprint Palette */
      --bg-void: #080604;
      --bg-deep: #0f0c09;
      --bg-surface: #161210;
      --bg-elevated: #1e1a16;
      --bg-card: #1a1612;

      /* Blueprint Lines */
      --line-subtle: rgba(212, 168, 83, 0.03);
      --line-default: rgba(212, 168, 83, 0.06);
      --line-mid: rgba(212, 168, 83, 0.12);
      --line-strong: rgba(212, 168, 83, 0.25);

      /* Accent Colors */
      --accent-gold: #d4a853;
      --accent-gold-bright: #f0c96c;
      --accent-gold-dim: rgba(212, 168, 83, 0.15);
      --accent-amber: #e67e22;
      --accent-copper: #cd7f32;
      --accent-cream: #f5e6c8;

      /* Text Hierarchy */
      --text-primary: #f0e6d8;
      --text-secondary: #a89888;
      --text-muted: #6a5a4a;

      /* Typography */
      --font-display: 'Noto Serif SC', 'Noto Serif SC', Georgia, serif;
      --font-body: 'Noto Sans SC', 'Space Grotesk', -apple-system, sans-serif;
      --font-mono: 'IBM Plex Mono', 'SF Mono', monospace;

      /* Spacing */
      --space-xs: 0.5rem;
      --space-sm: 1rem;
      --space-md: 1.5rem;
      --space-lg: 2.5rem;
      --space-xl: 4rem;
      --space-2xl: 7rem;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
    }

    body {
      font-family: var(--font-body);
      background: var(--bg-void);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .bg-grid {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        linear-gradient(var(--line-subtle) 1px, transparent 1px),
        linear-gradient(90deg, var(--line-subtle) 1px, transparent 1px),
        linear-gradient(var(--line-default) 1px, transparent 1px),
        linear-gradient(90deg, var(--line-default) 1px, transparent 1px),
        linear-gradient(var(--line-mid) 1px, transparent 1px),
        linear-gradient(90deg, var(--line-mid) 1px, transparent 1px);
      background-size:
        4px 4px, 4px 4px,
        12px 12px, 12px 12px,
        48px 48px, 48px 48px;
    }

    .bg-glow {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 100% 60% at 50% -10%, rgba(212, 168, 83, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 60% 40% at 90% 110%, rgba(230, 126, 34, 0.05) 0%, transparent 50%);
    }

    .scanline {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent-gold-dim), transparent);
      animation: scan 8s linear infinite;
      z-index: 1000;
      pointer-events: none;
      opacity: 0.5;
    }

    @keyframes scan {
      0% { top: -2px; }
      100% { top: 100%; }
    }

    h1, h2, h3 {
      font-weight: 600;
      letter-spacing: -0.025em;
    }

    code {
      font-family: var(--font-mono);
      font-size: 0.85em;
      background: var(--bg-elevated);
      border: 1px solid var(--line-mid);
      border-radius: 3px;
      padding: 0.15em 0.4em;
      color: var(--accent-gold-bright);
      letter-spacing: -0.02em;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    section {
      position: relative;
      z-index: 1;
      padding: var(--space-2xl) 0;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-gold);
      margin-bottom: 1.25rem;
      padding: 0.4rem 0.85rem;
      background: var(--bg-surface);
      border: 1px solid var(--line-mid);
      border-radius: 2px;
    }

    .eyebrow::before {
      content: '';
      width: 5px;
      height: 5px;
      background: var(--accent-gold);
      transform: rotate(45deg);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 500;
      font-optical-sizing: auto;
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: var(--text-primary);
      max-width: 620px;
    }

    .section-title em {
      font-style: italic;
      color: var(--accent-gold);
    }

    .section-desc {
      margin-top: 1.25rem;
      font-size: 1.1rem;
      color: var(--text-secondary);
      max-width: 540px;
      line-height: 1.75;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 3rem;
      background: rgba(8, 6, 4, 0.9);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--line-default);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      color: var(--text-primary);
    }

    .nav-logo svg { flex-shrink: 0; }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-right a {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      position: relative;
    }

    .nav-right a:hover { color: var(--accent-gold); }

    .nav-right a::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--accent-gold);
      transition: width 0.3s ease;
    }

    .nav-right a:hover::after { width: 100%; }

    .lang-switch {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      transition: all 0.2s ease;
    }

    .lang-switch:hover {
      border-color: var(--accent-gold);
      color: var(--accent-gold);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--bg-void);
      background: var(--accent-gold);
      border-radius: 2px;
      transition: all 0.2s ease;
    }

    .nav-cta:hover {
      background: var(--accent-gold-bright);
      transform: translateY(-1px);
    }

    .hero {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 8rem 2rem 6rem;
      overflow: hidden;
    }

    .hero-mark {
      position: absolute;
      width: 32px;
      height: 32px;
      border-color: var(--accent-gold);
      border-style: solid;
      opacity: 0.25;
    }

    .hero-mark-tl { top: 5rem; left: 3rem; border-width: 2px 0 0 2px; }
    .hero-mark-tr { top: 5rem; right: 3rem; border-width: 2px 2px 0 0; }
    .hero-mark-bl { bottom: 5rem; left: 3rem; border-width: 0 0 2px 2px; }
    .hero-mark-br { bottom: 5rem; right: 3rem; border-width: 0 2px 2px 0; }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.12;
      animation: float 12s ease-in-out infinite;
    }

    .orb-1 {
      width: 500px;
      height: 500px;
      background: var(--accent-gold);
      top: 5%;
      left: 5%;
      animation-delay: 0s;
    }

    .orb-2 {
      width: 350px;
      height: 350px;
      background: var(--accent-amber);
      bottom: 10%;
      right: 8%;
      animation-delay: -6s;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(30px, -30px); }
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid var(--line-strong);
      border-radius: 50px;
      padding: 0.45rem 1.1rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-muted);
      letter-spacing: 0.1em;
      margin-bottom: 2.5rem;
      background: rgba(8, 6, 4, 0.7);
      backdrop-filter: blur(10px);
      animation: fadeInUp 0.8s ease-out 0.1s both;
    }

    .hero-badge .dot {
      width: 5px;
      height: 5px;
      background: var(--accent-gold);
      border-radius: 50%;
      animation: pulse 2.5s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--accent-gold-dim); }
      50% { opacity: 0.5; box-shadow: 0 0 0 4px transparent; }
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 8vw, 5rem);
      font-weight: 500;
      font-optical-sizing: auto;
      font-style: italic;
      letter-spacing: -0.04em;
      line-height: 1.2;
      color: var(--text-primary);
      max-width: 800px;
      animation: fadeInUp 0.8s ease-out 0.2s both;
    }

    .hero h1 em {
      font-style: normal;
      color: var(--accent-gold);
    }

    .hero-tagline {
      margin-top: 1.75rem;
      font-size: 1.15rem;
      color: var(--text-secondary);
      max-width: 480px;
      line-height: 1.7;
      animation: fadeInUp 0.8s ease-out 0.3s both;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero-actions {
      display: flex;
      gap: 1.25rem;
      align-items: center;
      margin-top: 2.5rem;
      flex-wrap: wrap;
      justify-content: center;
      animation: fadeInUp 0.8s ease-out 0.5s both;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.85rem 1.75rem;
      border-radius: 3px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .btn-primary {
      background: var(--accent-gold);
      color: var(--bg-void);
      border: 1px solid var(--accent-gold);
    }

    .btn-primary:hover {
      background: var(--accent-gold-bright);
      box-shadow: 0 8px 32px rgba(212, 168, 83, 0.25);
      transform: translateY(-2px);
    }

    .btn-outline {
      background: transparent;
      border: 1px solid var(--line-strong);
      color: var(--text-secondary);
    }

    .btn-outline:hover {
      border-color: var(--accent-gold);
      color: var(--accent-gold);
      background: rgba(212, 168, 83, 0.05);
    }

    .hero-terminal {
      margin-top: 1.5rem;
      width: 100%;
      max-width: 680px;
      background: var(--bg-surface);
      border: 1px solid var(--line-strong);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 32px 64px rgba(0, 0, 0, 0.4);
      animation: fadeInUp 0.6s ease-out 0.6s both;
    }

    .term-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid var(--line-default);
      background: rgba(0, 0, 0, 0.2);
    }

    .term-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      transition: transform 0.2s ease;
    }

    .term-dot:hover { transform: scale(1.1); }
    .term-dot-r { background: #ff6b6b; }
    .term-dot-y { background: #ffd93d; }
    .term-dot-g { background: #6bcb77; }

    .term-title {
      margin: 0 auto;
      font-size: 0.75rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    .term-body {
      padding: 1.25rem 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.9;
      text-align: left;
    }

    .tc-dim    { color: var(--text-muted); }
    .tc-text   { color: var(--text-primary); }
    .tc-cyan   { color: var(--accent-gold); }
    .tc-gold   { color: var(--accent-gold); }
    .tc-green  { color: var(--accent-green); }
    .tc-purple { color: #c49bff; }

    .scroll-cue {
      margin-top: 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      animation: fadeInUp 0.6s ease-out 0.8s both;
    }

    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(180deg, var(--accent-gold) 0%, transparent 100%);
      animation: drip 2.5s ease-in-out infinite;
    }

    @keyframes drip {
      0%, 100% { opacity: 0.3; transform: scaleY(0.8); }
      50% { opacity: 1; transform: scaleY(1); }
    }

    .ide-section {
      border-top: 1px solid var(--line-default);
      text-align: center;
      padding: 3rem 2rem 3.5rem;
      background: rgba(0, 0, 0, 0.15);
    }

    .ide-label {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .ide-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
    }

    .ide-chip {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--line-default);
      border-radius: 6px;
      padding: 0.45rem 1rem;
      font-size: 0.8rem;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      transition: all 0.2s ease;
    }

    .ide-chip:hover {
      border-color: var(--accent-gold);
      color: var(--accent-gold);
      background: rgba(212, 168, 83, 0.05);
    }

    .ide-dot { width: 7px; height: 7px; border-radius: 50%; }
    .ide-chip.supported .ide-dot { background: var(--accent-green); }
    .ide-chip:not(.supported) .ide-dot { background: var(--text-muted); opacity: 0.5; }

    .why {
      border-top: 1px solid var(--line-default);
      border-bottom: 1px solid var(--line-default);
      background: rgba(0, 0, 0, 0.3);
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin-top: 3rem;
    }

    .compare-table {
      width: 100%;
      border-collapse: collapse;
    }

    .compare-table th {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      padding: 1rem;
      border-bottom: 1px solid var(--line-default);
      text-align: left;
    }

    .compare-table th:first-child { width: 35%; }

    .compare-table td {
      padding: 1.25rem 1rem;
      border-bottom: 1px solid var(--line-subtle);
      font-size: 0.95rem;
    }

    .compare-table .label {
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }

    .compare-table .bad { color: var(--text-muted); }
    .compare-table .good { color: var(--accent-gold); }

    .value-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .value-card {
      background: var(--bg-card);
      border: 1px solid var(--line-default);
      padding: 1.5rem;
      transition: all 0.3s ease;
    }

    .value-card:hover {
      border-color: var(--accent-gold);
      transform: translateY(-2px);
    }

    .value-card h3 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 500;
      font-style: italic;
      color: var(--accent-gold);
      margin-bottom: 0.75rem;
    }

    .value-card p {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .workflow-diagram svg,
    .workflow-flow,
    .flow-timeline {
      display: none;
    }

    .stripe-flow,
    .stripe-card,
    .stripe-arrow,
    .stripe-step,
    .stripe-icon,
    .stripe-badge {
      display: none;
    }

    /* ═══════════════════════════════════════════════════
       WORKFLOW SECTION - Command Lifecycle Flow
    ═══════════════════════════════════════════════════ */
    .lifecycle-flow {
      margin-top: 3rem;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Stage Labels (初始化, 规划, 构建, 审查) */
    .lifecycle-labels {
      display: flex;
      justify-content: center;
      gap: 60px;
      margin-bottom: 1rem;
      padding-left: 20px;
    }

    .lifecycle-label {
      width: 140px;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      color: var(--accent-gold);
      opacity: 0.7;
    }

    /* Main Flow Container */
    .lifecycle-main {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 0;
      position: relative;
    }

    /* Individual Stage */
    .lifecycle-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 160px;
      position: relative;
    }

    /* Stage Node (Card) */
    .stage-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem;
      background: var(--bg-surface);
      border: 2px solid var(--line-default);
      border-radius: 12px;
      width: 100%;
      transition: all 0.3s ease;
      position: relative;
    }

    .stage-node:hover {
      border-color: var(--accent-gold);
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.4);
    }

    .stage-number {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--bg-void);
      background: var(--accent-gold);
      border-radius: 50%;
    }

    .stage-icon {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(184,138,63,0.12);
      border-radius: 10px;
      margin-bottom: 0.75rem;
      color: var(--accent-gold);
    }

    .stage-node code {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-cyan);
      background: none;
      border: none;
      padding: 0;
      margin-bottom: 0.35rem;
    }

    .stage-title {
      font-size: 0.8rem;
      color: var(--text-primary);
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    .stage-output {
      font-size: 0.6rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
      text-align: center;
      line-height: 1.4;
    }

    /* Connector arrows between stages */
    .stage-connector {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      width: 50px;
      flex-shrink: 0;
      color: var(--accent-gold);
      opacity: 0.4;
      padding-top: 3rem;
    }

    .stage-connector svg {
      width: 24px;
      height: 24px;
    }

    /* Next Step Indicator */
    .stage-next {
      margin-top: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .next-label {
      font-size: 0.55rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .next-options {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .stage-next code {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--accent-gold);
      background: rgba(184,138,63,0.1);
      border: 1px solid rgba(184,138,63,0.2);
      padding: 0.2rem 0.4rem;
      border-radius: 3px;
    }

    .next-or {
      font-size: 0.6rem;
      color: var(--text-muted);
    }

    /* Optional Branch - UI Design */
    .lifecycle-branch {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      margin-top: 2rem;
      position: relative;
      gap: 1rem;
    }

    .branch-line {
      width: 200px;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(184,138,63,0.3), transparent);
      margin-top: 2rem;
    }

    .branch-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .branch-label {
      font-size: 0.6rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.3rem 0.75rem;
      border: 1px dashed var(--line-mid);
      border-radius: 4px;
    }

    .branch-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.25rem 1rem;
      background: rgba(22,18,16,0.6);
      border: 2px dashed rgba(184,138,63,0.3);
      border-radius: 12px;
      min-width: 140px;
      opacity: 0.85;
      transition: all 0.3s ease;
    }

    .branch-node:hover {
      opacity: 1;
      border-color: var(--accent-gold);
      background: rgba(184,138,63,0.05);
    }

    .branch-node .stage-icon {
      width: 36px;
      height: 36px;
      background: rgba(184,138,63,0.08);
      margin-bottom: 0.6rem;
    }

    .branch-node code {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-cyan);
      background: none;
      border: none;
      padding: 0;
      margin-bottom: 0.25rem;
    }

    .branch-node .stage-title {
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-bottom: 0.4rem;
    }

    .branch-node .stage-output {
      font-size: 0.55rem;
    }

    @media (max-width: 1000px) {
      .lifecycle-labels {
        display: none;
      }

      .lifecycle-main {
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: center;
      }

      .stage-connector {
        display: none;
      }

      .lifecycle-stage {
        width: 140px;
      }

      .lifecycle-branch {
        flex-direction: column;
        align-items: center;
      }

      .branch-line {
        width: 2px;
        height: 40px;
        background: linear-gradient(180deg, transparent, rgba(184,138,63,0.3), transparent);
        margin-top: 0;
      }
    }

    .workflow-steps {
      display: flex;
      gap: 0;
      margin-top: 3rem;
      position: relative;
    }

    .workflow-steps::before {
      content: '';
      position: absolute;
      top: 28px;
      left: 60px;
      right: 60px;
      height: 1px;
      background: var(--line-default);
    }

    .step {
      flex: 1;
      text-align: center;
      position: relative;
    }

    .step-num {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      margin: 0 auto 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--accent-gold);
      background: var(--bg-surface);
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      position: relative;
      z-index: 1;
    }

    .step h3 {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
    }

    .step p {
      font-size: 0.85rem;
      color: var(--text-muted);
      max-width: 180px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .step code { font-size: 0.7rem; padding: 0.1em 0.3em; }

    /* ═══════════════════════════════════════════════════
       PHASED WORKFLOW STYLES
    ═══════════════════════════════════════════════════ */
    .lifecycle-phase {
      margin-bottom: 3.5rem;
    }

    .lifecycle-phase:last-child {
      margin-bottom: 0;
    }

    .phase-title {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--accent-gold);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line-default);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .phase-badge {
      font-size: 0.6rem;
      font-weight: 500;
      color: var(--text-secondary);
      background: rgba(184,138,63,0.1);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      border: 1px solid rgba(184,138,63,0.2);
      text-transform: none;
      letter-spacing: 0;
    }

    /* Phase 1: Init Cards */
    .init-cards {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
    }

    .init-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1.5rem;
      background: var(--bg-surface);
      border: 2px solid var(--line-default);
      border-radius: 12px;
      min-width: 200px;
      transition: all 0.3s ease;
    }

    .init-card:hover {
      border-color: var(--accent-gold);
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.4);
    }

    .init-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(184,138,63,0.12);
      border-radius: 12px;
      margin-bottom: 1rem;
      color: var(--accent-gold);
    }

    .init-icon.inherit {
      background: rgba(184,138,63,0.12);
      color: var(--accent-gold);
    }

    .init-card code {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent-cyan);
      background: none;
      border: none;
      padding: 0;
      margin-bottom: 0.5rem;
    }

    .init-label {
      font-size: 0.9rem;
      color: var(--text-primary);
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    .init-desc {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-align: center;
      line-height: 1.5;
    }

    .init-divider {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .init-divider span {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.35rem 0.75rem;
      border: 1px solid var(--line-mid);
      border-radius: 20px;
    }

    /* Phase 2: UI Card */
    .ui-card {
      background: rgba(22,18,16,0.6);
      border: 2px dashed rgba(184,138,63,0.3);
      border-radius: 12px;
      padding: 1.5rem 2rem;
      max-width: 500px;
      margin: 0 auto;
      transition: all 0.3s ease;
    }

    .ui-card:hover {
      border-color: var(--accent-gold);
      background: var(--bg-elevated);
      transform: translateY(-2px);
    }

    .ui-flow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }

    .ui-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .ui-node code {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--accent-cyan);
      background: none;
      border: none;
      padding: 0;
    }

    .ui-label {
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    .ui-output {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .output-label {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .output-items {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--accent-gold);
    }

    /* Phase 3: Dev Cycle */
    .dev-cycle {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 0;
      position: relative;
    }

    .dev-stage {
      display: flex;
      align-items: flex-start;
    }

    .stage-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      color: var(--accent-gold);
      opacity: 0.6;
      padding-top: 3.5rem;
    }

    .stage-arrow svg {
      width: 24px;
      height: 24px;
    }

    /* Optional node with dashed border */
    .optional-node {
      border: 2px dashed var(--line-mid);
      position: relative;
    }

    .optional-node:hover {
      border-color: var(--accent-gold);
    }

    .optional-badge {
      position: absolute;
      top: -10px;
      right: -10px;
      font-family: var(--font-mono);
      font-size: 0.55rem;
      color: var(--text-muted);
      background: var(--bg-surface);
      border: 1px solid var(--line-mid);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Cycle arrow - loop back to plan */
    .cycle-arrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 80px;
      color: var(--accent-gold);
      opacity: 0.5;
      padding-top: 3.5rem;
      position: relative;
    }

    .cycle-arrow svg {
      width: 28px;
      height: 28px;
    }

    .cycle-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-transform: lowercase;
      letter-spacing: 0.05em;
      margin-top: 0.25rem;
    }

    /* Phase 4: Iterate Grid (3 columns) */
    .lifecycle-phase .iterate-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-top: 0;
    }

    .lifecycle-phase .iterate-card {
      background: var(--bg-surface);
      border: 1px solid var(--line-default);
      border-radius: 8px;
      padding: 1.25rem;
      transition: all 0.3s ease;
    }

    .lifecycle-phase .iterate-card:hover {
      border-color: var(--accent-gold);
      background: var(--bg-elevated);
      transform: translateY(-2px);
    }

    .lifecycle-phase .iterate-card .cmd {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-gold);
      margin-bottom: 0.75rem;
      display: block;
    }

    .lifecycle-phase .iterate-card h4 {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 500;
      font-style: italic;
      color: var(--text-primary);
      margin-bottom: 0.4rem;
    }

    .lifecycle-phase .iterate-card p {
      font-size: 0.75rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin: 0;
    }

    /* Responsive adjustments */
    @media (max-width: 900px) {
      .init-cards {
        flex-direction: column;
      }

      .init-divider {
        flex-direction: row;
      }

      .dev-cycle {
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }

      .stage-arrow,
      .cycle-arrow {
        display: none;
      }

      .ui-flow {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .lifecycle-phase .iterate-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .lifecycle-phase .iterate-grid {
        grid-template-columns: 1fr;
      }
    }

    .quickstart {
      background: rgba(0, 0, 0, 0.2);
    }

    /* Terminal Gate */
    .terminal-gate {
      margin-top: 3rem;
      text-align: center;
    }

    .gate-desc {
      font-size: 1.1rem;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    .terminal-window {
      max-width: 600px;
      margin: 0 auto;
      background: var(--bg-surface);
      border: 1px solid var(--line-default);
      border-radius: 8px;
      overflow: hidden;
    }

    .terminal-header {
      display: flex;
      gap: 6px;
      padding: 12px;
      background: rgba(255,255,255,0.03);
      border-bottom: 1px solid var(--line-default);
    }

    .terminal-header .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }

    .terminal-header .dot.red { background: #ff5f56; }
    .terminal-header .dot.yellow { background: #ffbd2e; }
    .terminal-header .dot.green { background: #27c93f; }

    .terminal-body {
      padding: 1.5rem 2rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      text-align: left;
    }

    .terminal-body .prompt {
      color: var(--text-muted);
      margin-right: 0.5rem;
    }

    .terminal-body .command {
      color: var(--accent-gold);
    }

    .terminal-output {
      margin-top: 1rem;
      padding-left: 1.5rem;
      border-left: 2px solid var(--line-default);
    }

    .terminal-output p {
      color: var(--text-muted);
      font-size: 0.8rem;
      margin: 0.25rem 0;
    }

    .terminal-output .success {
      color: var(--accent-gold);
    }

    /* Path Branch */
    .path-branch {
      margin-top: 4rem;
    }

    .branch-label {
      text-align: center;
      font-size: 1rem;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    .path-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .path-card {
      background: var(--bg-surface);
      border: 1px solid var(--line-default);
      border-radius: 12px;
      padding: 1.5rem;
    }

    .path-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line-default);
    }

    .path-tag {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--accent-gold);
      border: 1px solid var(--accent-gold);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
    }

    .path-header h3 {
      font-size: 1.1rem;
      color: var(--text-primary);
    }

    .path-flow {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .flow-step {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem;
      background: rgba(255,255,255,0.02);
      border-radius: 6px;
    }

    .flow-step.optional {
      border: 1px dashed var(--line-mid);
      background: transparent;
    }

    .flow-step code {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent-gold);
      white-space: nowrap;
    }

    .flow-step span {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .flow-arrow {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
    }

    /* Day 2+ Operations */
    .day2-ops {
      margin-top: 4rem;
      padding-top: 3rem;
      border-top: 1px solid var(--line-default);
    }

    .ops-label {
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .ops-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .op-item {
      text-align: center;
      padding: 1rem;
      background: var(--bg-surface);
      border: 1px solid var(--line-default);
      border-radius: 8px;
      transition: all 0.2s ease;
    }

    .op-item:hover {
      border-color: var(--accent-gold);
      background: var(--bg-elevated);
      transform: translateY(-2px);
    }

    .op-item code {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-gold);
      margin-bottom: 0.5rem;
    }

    .op-item span {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    @media (max-width: 768px) {
      .path-grid {
        grid-template-columns: 1fr;
      }
      .ops-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .terminal-body {
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.8;
      overflow-x: auto;
    }


    .cmd-list { list-style: none; }

    .cmd-item {
      display: grid;
      grid-template-columns: 130px 1fr;
      gap: 1rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--line-subtle);
    }

    .cmd-item:last-child { border-bottom: none; }

    .cmd-item code {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-gold);
      background: none;
      border: none;
      padding: 0;
    }

    .cmd-item .cmd-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }


    .cta {
      text-align: center;
      padding: 3rem 2rem;
      background:
        radial-gradient(ellipse 80% 50% at 50% 100%, rgba(212, 168, 83, 0.08) 0%, transparent 60%),
        var(--bg-deep);
      border-top: 1px solid var(--line-default);
    }

    .cta h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 500;
      font-style: italic;
      color: var(--text-primary);
      margin-bottom: 1rem;
    }

    .cta-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    footer {
      padding: 2rem;
      text-align: center;
      border-top: 1px solid var(--line-default);
      background: var(--bg-void);
    }

    footer p {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    footer a { color: var(--accent-gold); }

    @media (max-width: 1024px) {
      .why-grid { grid-template-columns: 1fr; gap: 3rem; }

      .iterate-grid { grid-template-columns: repeat(2, 1fr); }

      .workflow-steps { flex-wrap: wrap; gap: 2rem; }

      .step { flex: 0 0 calc(33.333% - 1.5rem); }

      .workflow-steps::before { display: none; }
    }

    @media (max-width: 640px) {
      nav { padding: 0 1.5rem; }
      .nav-right { display: none; }
      .hero h1 { font-size: 2.2rem; }
      .iterate-grid,
      .value-cards { grid-template-columns: 1fr; }
      .step { flex: 0 0 calc(50% - 1rem); }
    }
  </style>

</head>
<body>
