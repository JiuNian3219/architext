</footer>

<script>
  // Copy command bar
  const bar = document.getElementById('cmdBar');
  bar?.addEventListener('click', () => {
    navigator.clipboard.writeText('npx archi init').then(() => {
      bar.classList.add('is-copied');
      setTimeout(() => bar.classList.remove('is-copied'), 1800);
    });
  });

  // Quick Start tabs
  const tabNew      = document.getElementById('tab-new');
  const tabExisting = document.getElementById('tab-existing');
  const qsNew       = document.getElementById('qs-new');
  const qsExisting  = document.getElementById('qs-existing');

  tabNew?.addEventListener('click', () => {
    tabNew.classList.add('active');
    tabExisting?.classList.remove('active');
    if (qsNew) qsNew.style.display = '';
    if (qsExisting) qsExisting.style.display = 'none';
  });
  tabExisting?.addEventListener('click', () => {
    tabExisting.classList.add('active');
    tabNew?.classList.remove('active');
    if (qsExisting) qsExisting.style.display = '';
    if (qsNew) qsNew.style.display = 'none';
  });
</script>
</body>
</html>
