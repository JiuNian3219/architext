{
  "scope": "[?UI]",
  "status": "drafting",
  "primitivePalette": {
    "neutral": {
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a",
      "950": "#020617"
    },
    "brand": {}
  },
  "semanticTokens": {
    "colors": [
      {
        "token": "Background",
        "light": "White",
        "dark": "Neutral-950",
        "tailwind": "bg-background",
        "usage": "页面背景"
      },
      {
        "token": "Surface",
        "light": "Neutral-50",
        "dark": "Neutral-900",
        "tailwind": "bg-card",
        "usage": "卡片, 弹窗, 侧边栏"
      },
      {
        "token": "Primary",
        "light": "Brand-600",
        "dark": "Brand-500",
        "tailwind": "bg-primary",
        "usage": "主按钮, 激活状态"
      },
      {
        "token": "Text-Main",
        "light": "Neutral-900",
        "dark": "Neutral-50",
        "tailwind": "text-foreground",
        "usage": "正文, 标题"
      },
      {
        "token": "Text-Muted",
        "light": "Neutral-500",
        "dark": "Neutral-400",
        "tailwind": "text-muted-foreground",
        "usage": "次要信息, 注释"
      },
      {
        "token": "Border",
        "light": "Neutral-200",
        "dark": "Neutral-800",
        "tailwind": "border-border",
        "usage": "边框, 分割线"
      },
      {
        "token": "Destructive",
        "light": "Red-600",
        "dark": "Red-500",
        "tailwind": "bg-destructive",
        "usage": "删除, 错误提示"
      }
    ],
    "typography": [
      {
        "role": "H1",
        "fontFamily": "Sans",
        "size": "36px / 2.25rem",
        "weight": "700 (Bold)",
        "lineHeight": "1.2",
        "tailwind": "text-4xl font-bold"
      },
      {
        "role": "H2",
        "fontFamily": "Sans",
        "size": "30px / 1.875rem",
        "weight": "600 (Semi)",
        "lineHeight": "1.3",
        "tailwind": "text-3xl font-semibold"
      },
      {
        "role": "Body",
        "fontFamily": "Sans",
        "size": "16px / 1rem",
        "weight": "400 (Reg)",
        "lineHeight": "1.5",
        "tailwind": "text-base"
      },
      {
        "role": "Small",
        "fontFamily": "Sans",
        "size": "14px / 0.875rem",
        "weight": "500 (Med)",
        "lineHeight": "1.5",
        "tailwind": "text-sm font-medium"
      }
    ]
  },
  "layout": {
    "spacing": { "1": "4px", "4": "16px", "8": "32px" },
    "radius": [
      {
        "token": "Sm",
        "value": "4px",
        "class": "rounded-sm",
        "usage": "Tags, Small Inputs"
      },
      {
        "token": "Md",
        "value": "8px",
        "class": "rounded-md",
        "usage": "Buttons, Cards"
      },
      {
        "token": "Lg",
        "value": "12px",
        "class": "rounded-lg",
        "usage": "Modals, Large Containers"
      },
      {
        "token": "Full",
        "value": "9999px",
        "class": "rounded-full",
        "usage": "Avatars, Pills"
      }
    ],
    "shadows": [
      {
        "token": "Sm",
        "value": "0 1px 2px ...",
        "class": "shadow-sm",
        "usage": "Cards (Default)"
      },
      {
        "token": "Md",
        "value": "0 4px 6px ...",
        "class": "shadow",
        "usage": "Dropdowns, Popovers"
      }
    ],
    "animation": [
      {
        "token": "Fast",
        "value": "150ms ease-out",
        "class": "duration-150",
        "usage": "Hover effects"
      },
      {
        "token": "Normal",
        "value": "300ms ease-in-out",
        "class": "duration-300",
        "usage": "Modal open/close"
      }
    ]
  },
  "componentPresets": {
    "card": "bg-card rounded-lg shadow-sm border border-border p-6",
    "cardHeader": "flex items-center justify-between pb-4 border-b border-border",
    "button-primary": "bg-primary text-primary-foreground rounded-md px-4 py-2 text-sm font-medium shadow-sm hover:opacity-90 transition-opacity",
    "button-secondary": "bg-card text-foreground rounded-md px-4 py-2 text-sm font-medium border border-border hover:bg-muted transition-colors",
    "button-ghost": "bg-transparent hover:bg-muted rounded-md px-3 py-2 text-sm transition-colors",
    "button-destructive": "bg-destructive text-destructive-foreground rounded-md px-4 py-2 text-sm font-medium hover:opacity-90 transition-opacity",
    "input": "w-full rounded-md border border-border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors",
    "label": "text-sm font-medium text-foreground",
    "badge": "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium",
    "emptyState": "flex flex-col items-center justify-center py-16 text-muted-foreground gap-3",
    "skeleton": "animate-pulse rounded-md bg-muted",
    "toast": "rounded-lg shadow-md border border-border p-4 flex items-start gap-3",
    "divider": "h-px bg-border my-4",
    "pageContainer": "max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8",
    "sectionHeader": "flex items-center justify-between mb-6",
    "navItem": "flex items-center gap-2 px-3 py-2 rounded-md text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
  }
}
